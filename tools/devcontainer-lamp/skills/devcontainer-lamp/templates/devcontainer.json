// Generated by the devcontainer-lamp tool.
// Debian 13 + Apache + PHP __PHP_VERSION__ (app) and MySQL __MYSQL_VERSION__ (db).
{
  "name": "__PROJECT_NAME__ (Debian 13, PHP __PHP_VERSION__, Apache, MySQL __MYSQL_VERSION__)",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "runServices": ["app", "db"],
  "workspaceFolder": "__WORKSPACE_FOLDER__",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,

  // Add Dev Container Features here, for example Node.js:
  // "ghcr.io/devcontainers/features/node:1": {}
  "features": {},

  // Apache is __APACHE_PORT_NOTE__.
  "forwardPorts": [__FORWARD_80__"db:3306"],
  "portsAttributes": {
__PORT_ATTR__
    "db:3306": { "label": "MySQL", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash /workspace/.devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "xdebug.php-debug",
        "bmewburn.vscode-intelephense-client",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql"
      ],
      "settings": {
        "php.validate.executablePath": "/usr/bin/php",
        "sqltools.connections": [
          {
            "name": "Dev container MySQL",
            "driver": "MySQL",
            "server": "db",
            "port": 3306,
            "database": "__DB_NAME__",
            "username": "__DB_USER__",
            "password": "__DB_PASSWORD__"
          }
        ]
      }
    }
  }
}
