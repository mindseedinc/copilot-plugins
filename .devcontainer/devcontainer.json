// Generated by the devcontainer-lamp tool.
// Debian 13 + Apache + PHP 8.5 (app) and MySQL 26.7 (db).
{
  "name": "plugins (Debian 13, PHP 8.5, Apache, MySQL 26.7)",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "runServices": ["app", "db"],
  "workspaceFolder": "/var/www/httpdocs",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,

  // Workspace-specific tooling for the plugins in tools/:
  //   node   -> tools/social-search (Node.js 22+, Playwright)
  //   python -> tools/social-crawl (Python 3.9+)
  //   docker -> tools/devcontainer-lamp/tests/smoke-test.sh
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/python:1": { "version": "os-provided", "installTools": false },
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false }
  },

  // Apache is auto-forwarded to a free local port (see VS Code's Ports panel).
  "forwardPorts": [80,"db:3306"],
  "portsAttributes": {
    "80": { "label": "Apache", "onAutoForward": "notify" },
    "db:3306": { "label": "MySQL", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash /workspace/.devcontainer/post-create.sh && bash /workspace/.devcontainer/workspace-setup.sh",
  "containerEnv": { "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}" },

  "customizations": {
    "vscode": {
      "extensions": [
        "xdebug.php-debug",
        "bmewburn.vscode-intelephense-client",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql"
      ],
      "settings": {
        "php.validate.executablePath": "/usr/bin/php",
        "sqltools.connections": [
          {
            "name": "Dev container MySQL",
            "driver": "MySQL",
            "server": "db",
            "port": 3306,
            "database": "app",
            "username": "app",
            "password": "app"
          }
        ]
      }
    }
  }
}
